{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "epoch-particle-engine",
  "version-semver": "0.4.0",
  "description": "Deterministic grid and physics particle simulation with Vulkan rendering and Particle Studio",
